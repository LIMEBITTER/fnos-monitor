# 复制成 .env 后按需填写；docker compose 会自动读取（.env 不进仓库）
# 不用的项保持注释即可，代码里都有默认值。

# ---- 监听 ----
# PORT=8787
# HOST=0.0.0.0

# ---- 访问控制（两者同时设置才启用 Basic Auth）----
# STATUS_USER=admin
# STATUS_PASSWORD=change-me

# ---- 公网视图 ----
# 默认脱敏：隐藏探测目标、状态码、错误详情、版本号。
# 内网自用想直接看到这些信息时设为 true。
# EXPOSE_INTERNAL=true

# ---- 邮件告警（不填 ALERT_SMTP_HOST / ALERT_TO 就自动禁用）----
# ALERT_SMTP_HOST=smtp.qq.com
# ALERT_SMTP_PORT=465
# ALERT_SMTP_SECURE=true
# ALERT_SMTP_USER=you@qq.com
# ALERT_SMTP_PASS=授权码
# ALERT_FROM=you@qq.com
# ALERT_TO=you@qq.com
# ALERT_REPEAT_MINUTES=180
# ALERT_URL=https://status.example.com
# ALERT_TZ=Asia/Shanghai

# ---- 时区（影响按日聚合的边界）----
# TZ=Asia/Shanghai
